# Copy to .env.local (never committed). Every account below is opened with an OFFICIAL Devatop email, never a personal one.

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. The service role key bypasses row-level security: keep it out of client code and out of git.
SUPABASE_SERVICE_ROLE_KEY=
# Database > Connection string > "Direct connection" (used by `npm run db:migrate`)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Email (Brevo or Resend), sent from a Devatop address
EMAIL_FROM=volunteers@devatop.org
BREVO_API_KEY=

# Protects /api/cron/* (Vercel Cron sends it as a bearer token). Use a long random value.
CRON_SECRET=
