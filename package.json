{
  "name": "devatop-volunteers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "photos": "node tools/optimise-photos.mjs",
    "db:generate": "drizzle-kit generate",
    "db:permissions": "tsx tools/gen-permissions-sql.ts",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "db:migrate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "node --env-file=.env.local tools/db-check.mjs",
    "db:seed": "node --env-file=.env.local --import tsx tools/seed.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "^16.4.3",
    "postcss": "^8.5.31",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
